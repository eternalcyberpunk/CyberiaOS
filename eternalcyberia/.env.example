# --- core ---
NODE_ENV=development
DEV_USER=1                       # dev-only auth bypass; never set in prod

# --- data ---
DATABASE_URL=postgresql://ec:ec@localhost:5432/ec
REDIS_QUEUE_URL=redis://localhost:6379/0
REDIS_PUBSUB_URL=redis://localhost:6379/1

# --- services ---
API_PORT=4000
REALTIME_PORT=4001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001

# --- auth ---
SESSION_SECRET=change-me-32-bytes-minimum
CAPABILITY_SIGNING_KEY=dev-ed25519-private-key
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
OAUTH_GITHUB_ID=
OAUTH_GITHUB_SECRET=

# --- storage / compute ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ec-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
GPU_PROVIDER=runpod
GPU_API_KEY=

# --- ai ---
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=50
