{
  "name": "eternalcyberia",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "budget": "node scripts/check-budgets.mjs",
    "db:push": "pnpm --filter @ec/schema exec prisma db push",
    "db:studio": "pnpm --filter @ec/schema exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.4",
    "@playwright/test": "^1.46.0",
    "prettier": "^3.3.3",
    "eslint": "^9.9.0",
    "vitest": "^2.0.5"
  }
}
